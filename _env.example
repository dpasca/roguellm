# Environment Variables Template
# Copy this content to a .env file and fill in your actual API keys

# Runtime Environment
# Use development locally. Set APP_ENV=production on the public server.
APP_ENV=development

# Session Security
# Generate a secure random string for session encryption
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=your_secure_random_session_key_here
# Production requires a real 32+ character SESSION_SECRET_KEY and will not
# start with the placeholder above.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=1209600

# Abuse Protection
# Applies to username/password auth and fresh World generation.
AUTH_RATE_LIMIT_ENABLED=1
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_SIGNUP_MAX_ATTEMPTS=5
AUTH_SIGNUP_WINDOW_SECONDS=3600
WORLD_CREATION_MAX_ATTEMPTS=10
WORLD_CREATION_WINDOW_SECONDS=3600

# World Publishing
# Newly generated Worlds are private by default. Production ignores non-private
# overrides until the public review flow is implemented.
DEFAULT_NEW_WORLD_VISIBILITY=private
# Production should require login before creating fresh generated Worlds.
# Existing public and unlisted Worlds remain playable without login.
REQUIRE_LOGIN_TO_CREATE_WORLD=0

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

# For OpenAI models (default configuration)
LOW_SPEC_MODEL_NAME=gpt-4.1-mini
HIGH_SPEC_MODEL_NAME=gpt-4.1-mini
LOW_SPEC_MODEL_API_KEY=your_openai_api_key_here
HIGH_SPEC_MODEL_API_KEY=your_openai_api_key_here

# Alternative: Use different models for low and high spec
# LOW_SPEC_MODEL_NAME=gpt-4.1-mini
# HIGH_SPEC_MODEL_NAME=gpt-4.1

# For custom OpenAI-compatible endpoints (optional)
# LOW_SPEC_MODEL_BASE_URL=https://api.openai.com/v1
# HIGH_SPEC_MODEL_BASE_URL=https://api.openai.com/v1

# Search Provider Configuration (optional)
# Possible providers: duckduckgo, serpapi
SEARCH_PROVIDER=duckduckgo
# SerpApi key if using SerpApi provider (optional)
# SERPAPI_KEY=your_serpapi_key_here

# Database Storage Configuration (Optional)
# How often to upload database to cloud storage (in minutes)
# Default: 5 minutes
# UPLOAD_FREQUENCY_MINUTES=5

# Firebase Configuration (Optional)
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_MESSAGING_SENDER_ID=
# FIREBASE_APP_ID=
# FIREBASE_MEASUREMENT_ID=
