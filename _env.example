# Environment Variables Template
# Copy this content to a .env file and fill in your actual API keys

# Runtime Environment
# Use development locally. Set APP_ENV=production on the public server.
APP_ENV=development

# Session Security
# Generate a secure random string for session encryption
# You can generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=your_secure_random_session_key_here
# Production requires a real 32+ character SESSION_SECRET_KEY and will not
# start with the placeholder above.
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_MAX_AGE_SECONDS=1209600

# Abuse Protection
# Applies to username/password auth and fresh World generation.
AUTH_RATE_LIMIT_ENABLED=1
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=60
AUTH_SIGNUP_MAX_ATTEMPTS=5
AUTH_SIGNUP_WINDOW_SECONDS=3600
WORLD_CREATION_MAX_ATTEMPTS=10
WORLD_CREATION_WINDOW_SECONDS=3600

# Admin Area
# Comma-separated registered usernames allowed to access /admin.
# Leave empty to disable the admin area.
ADMIN_USERNAMES=

# World Publishing
# Newly generated Worlds are private by default. Public publishing is a queued
# LLM review flow; direct public visibility should not be enabled in production.
DEFAULT_NEW_WORLD_VISIBILITY=private
# Production should require login before creating fresh generated Worlds.
# Existing public and unlisted Worlds remain playable without login.
REQUIRE_LOGIN_TO_CREATE_WORLD=0

# Public World review. Defaults reuse LOW_SPEC_MODEL_* below, but these let us
# assign a separate reviewer model or OpenAI-compatible endpoint. Reviews run
# immediately unless the pending review queue reaches the immediate threshold.
WORLD_PUBLIC_REVIEW_DELAY_SECONDS=0
WORLD_PUBLIC_REVIEW_IMMEDIATE_ENABLED=1
WORLD_PUBLIC_REVIEW_IMMEDIATE_MAX_PENDING=10
WORLD_PUBLIC_REVIEW_POLL_SECONDS=30
WORLD_PUBLIC_REVIEW_MAX_PER_POLL=3
WORLD_PUBLIC_REVIEW_WORKER_ENABLED=1
# WORLD_PUBLIC_REVIEW_MODEL_NAME=gpt-5.6-luna
# WORLD_PUBLIC_REVIEW_MODEL_BASE_URL=https://api.openai.com/v1
# WORLD_PUBLIC_REVIEW_MODEL_API_KEY=your_review_model_api_key_here
# Review is the one call whose mistakes get published, so gpt-5.6-terra with
# effort "low" is worth considering here.
# WORLD_PUBLIC_REVIEW_MODEL_REASONING_EFFORT=none

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys

# For OpenAI models (default configuration)
LOW_SPEC_MODEL_NAME=gpt-5.6-luna
HIGH_SPEC_MODEL_NAME=gpt-5.6-terra
LOW_SPEC_MODEL_API_KEY=your_openai_api_key_here
HIGH_SPEC_MODEL_API_KEY=your_openai_api_key_here

# Reasoning effort: none, low, medium, high, xhigh, max. Luna is cheap enough
# per token to be worth running at high effort, since worldgen quality is the
# product. The setting is ignored for models that predate reasoning, so pinning
# gpt-4.1-mini here still works.
LOW_SPEC_MODEL_REASONING_EFFORT=high
HIGH_SPEC_MODEL_REASONING_EFFORT=low

# Alternative: gpt-5.6-sol is the deepest tier; gpt-4.1-mini is the previous
# default and deprecates 2026-11-04.
# LOW_SPEC_MODEL_NAME=gpt-5.6-luna
# HIGH_SPEC_MODEL_NAME=gpt-5.6-sol

# For custom OpenAI-compatible endpoints (optional)
# LOW_SPEC_MODEL_BASE_URL=https://api.openai.com/v1
# HIGH_SPEC_MODEL_BASE_URL=https://api.openai.com/v1

# World art generation (optional, costs money per forged World).
# Off by default. Roughly 12 images per World: ~$0.35 at medium quality,
# ~$0.06 at low. gpt-image-1-mini is removed from the API on 2026-12-01 and
# gpt-image-1 deprecates 2026-10-23, so neither is a safe default.
ENABLE_WORLD_ART=0
# IMAGE_MODEL_NAME=gpt-image-2
# IMAGE_MODEL_QUALITY=medium
# Falls back to LOW_SPEC_MODEL_API_KEY when unset.
# IMAGE_MODEL_API_KEY=your_openai_api_key_here
# IMAGE_MODEL_BASE_URL=https://api.openai.com/v1
# Generated art lives inside the existing data volume so there is one thing to
# back up and one thing to move when the app changes hosts.
# WORLD_ASSETS_DIR=_data/assets

# Search Provider Configuration (optional)
# Possible providers: duckduckgo, serpapi
SEARCH_PROVIDER=duckduckgo
# SerpApi key if using SerpApi provider (optional)
# SERPAPI_KEY=your_serpapi_key_here

# Database Storage Configuration (Optional)
# How often to upload database to cloud storage (in minutes)
# Default: 5 minutes
# UPLOAD_FREQUENCY_MINUTES=5

# Firebase Configuration (Optional)
# Set to 1 only after all Firebase values below are configured.
ANALYTICS_ENABLED=0
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
